<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.simonides.sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>HOME_PLACEHOLDER/bin/simonides-sync.sh</string>
  </array>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>HOME_PLACEHOLDER/Library/Logs/simonides-sync.launchd.log</string>
  <key>StandardErrorPath</key><string>HOME_PLACEHOLDER/Library/Logs/simonides-sync.launchd.log</string>
</dict>
</plist>
